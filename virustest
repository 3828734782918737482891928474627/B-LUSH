-- 🧩 Helper: Create Toggle Switch
local function CreateToggle(parent, text, defaultState, callback)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, 0, 0, 32)
    Row.BackgroundTransparency = 1
    Row.Parent = parent

    local SwitchContainer = Instance.new("Frame")
    SwitchContainer.Size = UDim2.new(0, 44, 0, 24)
    SwitchContainer.Position = UDim2.new(0, 0, 0.5, -12)
    SwitchContainer.BackgroundColor3 = defaultState and Theme.ToggleOn or Theme.ToggleOff
    SwitchContainer.Parent = Row

    local SwitchCorner = Instance.new("UICorner")
    SwitchCorner.CornerRadius = UDim.new(0, 12)
    SwitchCorner.Parent = SwitchContainer

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 20, 0, 20)
    Knob.Position = defaultState and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
    Knob.BackgroundColor3 = Theme.SoftWhite
    Knob.Parent = SwitchContainer

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -60, 1, 0)
    Label.Position = UDim2.new(0, 56, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Theme.TextDark
    Label.TextSize = 13
    Label.Font = Enum.Font.GothamSemibold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Row

    local state = defaultState
    local function update(s)
        state = s
        SwitchContainer.BackgroundColor3 = s and Theme.ToggleOn or Theme.ToggleOff
        Knob.Position = s and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
    end

    Row.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            update(not state)
            callback(state)
        end
    end)

    return update
end

