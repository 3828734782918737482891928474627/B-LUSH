-- 🧠 Core Logic (unchanged & preserved fully)
local function getUserIdFromInput(input)
    input = tostring(input or ""):gsub("%s+", ""):gsub("^@", "")
    if input == "" then return nil end
    local id = tonumber(input)
    if id then return id end
    local success, result = pcall(function()
        return Players:GetUserIdFromNameAsync(input)
    end)
    if success and result then return result end
    return nil
end

local function applyAnimationsFromDummy(char, dummyModel)
    local myAnimate = char:FindFirstChild("Animate")
    local dummyAnimate = dummyModel:FindFirstChild("Animate")
    local myHumanoid = char:FindFirstChildOfClass("Humanoid")
    if not myAnimate or not dummyAnimate or not myHumanoid then return end
    local animator = myHumanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do t:Stop(0) end
    end
    for _, dc in ipairs(dummyAnimate:GetChildren()) do
        local mc = myAnimate:FindFirstChild(dc.Name)
        if mc then
            for _, a in ipairs(dc:GetChildren()) do
                if a:IsA("Animation") then
                    local ta = mc:FindFirstChild(a.Name)
                    if ta and ta:IsA("Animation") then
                        ta.AnimationId = a.AnimationId
                    else
                        a:Clone().Parent = mc
                    end
                end
            end
        end
    end
    myAnimate.Disabled = true
    task.wait(0.05)
    myAnimate.Disabled = false
end

local function applyFullOutfit(char)
    if not isAvatarEnabled or targetUserInput == "" then return end
    local id = getUserIdFromInput(targetUserInput)
    if not id then return end
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        local ok, dummy = pcall(function()
            return Players:CreateHumanoidModelFromUserId(id)
        end)
        if not ok or not dummy then return end
        
        -- Clear old outfit
        for _, x in ipairs(char:GetChildren()) do
            if x:IsA("Accessory") or x:IsA("Shirt") or x:IsA("Pants") 
                or x:IsA("ShirtGraphic") or x:IsA("BodyColors") 
                or x:IsA("CharacterMesh") then
                x:Destroy()
            end
        end
        
        -- Apply description
        pcall(function()
            local dHum = dummy:FindFirstChildOfClass("Humanoid")
            if dHum then
                local desc = dHum:GetAppliedDescription()
                if desc then hum:ApplyDescription(desc) end
            end
        end)
        
        -- BodyColors
        local tbc = dummy:FindFirstChildOfClass("BodyColors")
        if tbc then
            local obc = char:FindFirstChildOfClass("BodyColors")
            if obc then obc:Destroy() end
            tbc:Clone().Parent = char
        end
        
        -- Clothing
        for _, x in ipairs(dummy:GetChildren()) do
            if x:IsA("Shirt") or x:IsA("Pants") or x:IsA("ShirtGraphic") or x:IsA("CharacterMesh") then
                x:Clone().Parent = char
            end
        end
        
        -- Meshes
        for _, dp in ipairs(dummy:GetChildren()) do
            if dp:IsA("MeshPart") and dp.Name ~= "Head" then
                local mp = char:FindFirstChild(dp.Name)
                if mp and mp:IsA("MeshPart") then
                    pcall(function()
                        mp.MeshId = dp.MeshId
                        mp.TextureID = dp.TextureID
                    end)
                end
            end
        end
        
        -- Head handling
        local tHead = dummy:FindFirstChild("Head")
        local mHead = char:FindFirstChild("Head")
        if tHead and mHead then
            local oldFake = char:FindFirstChild("FakeHead")
            if oldFake then oldFake:Destroy() end
            for _, c in ipairs(mHead:GetChildren()) do
                if c:IsA("SpecialMesh") or c:IsA("CharacterMesh") 
                    or c:IsA("Decal") or c:IsA("Texture") 
                    or c:IsA("SurfaceAppearance") or c:IsA("WrapTarget") then
                    c:Destroy()
                end
            end
            mHead.Color = tHead.Color
            local meshOk = false
            if tHead:IsA("MeshPart") and mHead:IsA("MeshPart") then
                meshOk = pcall(function()
                    mHead.MeshId = tHead.MeshId
                    mHead.TextureID = tHead.TextureID
                end)
            end
            for _, c in ipairs(tHead:GetChildren()) do
                if c:IsA("SpecialMesh") or c:IsA("Decal") or c:IsA("SurfaceAppearance") then
                    c:Clone().Parent = mHead
                end
            end
            if tHead:IsA("MeshPart") and not meshOk then
                mHead.Transparency = 1
                local fake = tHead:Clone()
                fake.Name = "FakeHead"
                fake.CanCollide = false
                fake.Parent = char
                local weld = Instance.new("Weld")
                weld.Part0 = mHead
                weld.Part1 = fake
                weld.C0 = CFrame.new()
                weld.C1 = CFrame.new()
                weld.Parent = fake
            else
                mHead.Transparency = tHead.Transparency
            end
        end
        
        -- Accessories
        for _, acc in ipairs(dummy:GetChildren()) do
            if acc:IsA("Accessory") then
                local nc = acc:Clone()
                local hand = nc:FindFirstChild("Handle")
                if hand then
                    hand.CanCollide = false
                    nc.Parent = char
                    local att = hand:FindFirstChildOfClass("Attachment")
                    if att then
                        local targetAtt = nil
                        for _, p in ipairs(char:GetChildren()) do
                            if p:IsA("BasePart") then
                                local a = p:FindFirstChild(att.Name)
                                if a and a:IsA("Attachment") then
                                    targetAtt = a; break
                                end
                            end
                        end
                        if targetAtt then
                            local w = Instance.new("Weld")
                            w.Part0 = hand
                            w.Part1 = targetAtt.Parent
                            w.C0 = att.CFrame
                            w.C1 = targetAtt.CFrame
                            w.Parent = hand
                        end
                    else
                        local head = char:FindFirstChild("Head")
                        if head then
                            local w = Instance.new("Weld")
                            w.Part0 = hand
                            w.Part1 = head
                            w.C0 = CFrame.new()
                            w.C1 = CFrame.new()
                            w.Parent = hand
                        end
                    end
                end
            end
        end
        
        applyAnimationsFromDummy(char, dummy)
        
        -- Headless effect
        if isHeadlessEnabled then
            task.wait(0.1)
            if mHead then
                mHead.Transparency = 1
                local face = mHead:FindFirstChildOfClass("Decal")
                if face then face.Transparency = 1 end
                local fake = char:FindFirstChild("FakeHead")
                if fake then fake.Transparency = 1 end
            end
        end
        
        dummy:Destroy()
    end)
end

local function resetCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Health = 0
    else
        pcall(function() char:BreakJoints() end)
    end
end

